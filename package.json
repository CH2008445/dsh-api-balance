{
  "name": "dsh-api-balance",
  "version": "1.3.0",
  "description": "DeepSeek API account balance and per-run usage cost for the DeepSeek Harness web GUI. The API key never leaves the host process.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "balance",
    "cordis"
  ],
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.ru.md",
    "README.de.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CH2008445/dsh-api-balance.git"
  },
  "bugs": {
    "url": "https://github.com/CH2008445/dsh-api-balance/issues"
  },
  "homepage": "https://github.com/CH2008445/dsh-api-balance#readme"
}
